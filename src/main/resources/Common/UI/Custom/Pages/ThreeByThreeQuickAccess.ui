$C = "../Common.ui";
Group {
  LayoutMode: Top;
  Background: (Color: #414141);
  Anchor: (Width: 600, Height: 600);
  Group #R0 {
    LayoutMode: Right;
    Background: (Color: #333333);
    Anchor: (Height: 60);
    Padding: (Full: 0);
    $C.@TextButton #QuickAccessButtonSettings {
      Anchor: (Width: 120, Height: 60);
      Padding: (Full: 0);
      Text: "Settings";
    }
  }
  Group #R1andR2 {
    LayoutMode: Left;
    Background: (Color: #333333);
    Anchor: (Height: 120);
    Padding: (Full: 0);
    Group #R1andR2Spacer0 {
      LayoutMode: Top;
      Background: (Color: #333333);
      Anchor: (Width: 60, Height: 120);
      Padding: (Full: 0);
    }
    $C.@TextButton #QuickAccessButton5 {
      Anchor: (Width: 120, Height: 120);
      Padding: (Full: 0);
      Text: "BTN 5";
    }
    Group #R1andR2Spacer1 {
