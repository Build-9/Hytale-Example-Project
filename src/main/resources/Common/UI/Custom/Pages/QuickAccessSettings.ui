$C = "../Common.ui";
Group {
  LayoutMode: Top;
  Background: (Color: #333333);
  Anchor: (Width: 600, Height: 450);
  Padding: (Left: 10, Top: 10);
  Group #R0Title {
    LayoutMode: CenterMiddle;
    Background: (Color: #333333);
    Padding: (Full: 0);
    Label #TitleLabel {
      Padding: (Full: 0);
      Text: "Quick Access Player Settings";
      Style: (TextColor: #ffffff);
    }
  }
  Group #R1Body {
    LayoutMode: Top;
    Background: (Color: #333333);
    Anchor: (Width: 542, Height: 323, Left: 21, Right: 16, Top: 19, Bottom: 108);
    Padding: (Full: 0);
    Group #BodyR0Checkbox {
      LayoutMode: Left;
      Background: (Color: #333333);
      Anchor: (Height: 50);
      Padding: (Full: 0);
      Label #EquippedLabel {
        Anchor: (Width: 200);
        Padding: (Full: 0);
        Text: "Enable Quick Swap";
        Style: (TextColor: #ffffff);
      }
      $C.@CheckBoxWithLabel #IsEnabledCheckbox {
        @Text = "";
        LayoutMode: Top;
        Background: (Color: #333333);
        Anchor: (Height: 25);
        Padding: (Full: 0);
      }
    }
    Group #BodyR1NumberInput {
      LayoutMode: Left;
      Background: (Color: #333333);
      Anchor: (Height: 50);
      Padding: (Full: 0);
      Label #Labelf1fa64b3 {
        Anchor: (Width: 200);
        Padding: (Full: 0);
        Text: "Equipped Hotbar Location [0 -> 8]";
        Style: (TextColor: #ffffff);
      }
      $C.@NumberField #EquippedNumberField {
        Anchor: (Width: 50, Height: 25);
        Padding: (Full: 0);
      }
    }
    Group #BodyR2NumberInput {
      LayoutMode: Left;
      Background: (Color: #333333);
      Anchor: (Height: 50);
      Padding: (Full: 0);
      Label #Label8e37c11f {
        Anchor: (Width: 200);
        Padding: (Full: 0);
        Text: "Target Hotbar Location [-1 -> 8]";
        Style: (TextColor: #ffffff);
      }
      $C.@NumberField #TargetNumberField {
        Anchor: (Width: 50, Height: 25);
        Padding: (Full: 0);
      }
    }
    Group #BodyR3StringInput {
      LayoutMode: Left;
      Background: (Color: #333333);
      Anchor: (Height: 250);
      Padding: (Full: 0);
      Label #Labelba698751 {
        Anchor: (Width: 200, Height: 100);
        Padding: (Full: 0);
        Text: "Radial Menu Layout";
        Style: (TextColor: #ffffff);
      }
      Group #FilePicker {
        LayoutMode: Top;
        Anchor: (Width: 275, Height: 250);
        $C.@TextField #GuiFileTextField {
          Anchor: (Width: 275, Height: 25);
          Padding: (Full: 0);
          Value: "Pages/TwoByTwoQuickAccess.ui";
          PlaceholderText: "Pages/TwoByTwoQuickAccess.ui";
        }
        Group #FileSelectSpacer {
          LayoutMode: Top;
          Padding: (Full: 0);
          Anchor: (Height: 5);
        }
        $C.@TextButton #TwoByTwoUiButton {
          Anchor: (Width: 150, Height: 50);
          Padding: (Full: 0);
          Text: "Two-By-Two Radial";
        }
        $C.@TextButton #ThreeByThreeUiButton {
          Anchor: (Width: 150, Height: 50);
          Padding: (Full: 0);
          Text: "Three-By-Three Radial";
        }
        $C.@TextButton #FourByFourUiButton {
          Anchor: (Width: 150, Height: 50);
          Padding: (Full: 0);
          Text: "Four-By-Four Radial";
        }
        $C.@TextButton #FiveByFiveUiButton {
          Anchor: (Width: 150, Height: 50);
          Padding: (Full: 0);
          Text: "Five-By-Five Radial";
        }
      }
    }
    Group #BodyR4Button {
      LayoutMode: CenterMiddle;
      Background: (Color: #333333);
      Anchor: (Height: 75);
      Padding: (Full: 0);
      $C.@TextButton #SubmitButton {
        Anchor: (Width: 150, Height: 50);
        Padding: (Full: 0);
        Text: "Submit";
      }
      Group #SpacerHoriz {
        LayoutMode: Top;
        Anchor: (Width: 150);
        Background: (Color: #333333);
        Padding: (Full: 0);
      }
      $C.@TextButton #ResetButton {
        Anchor: (Width: 150, Height: 50);
        Padding: (Full: 0);
        Text: "Reset";
      }
    }
  }
}
