$C = "../../../Common.ui";

Group {
    LayoutMode: Top;
    Background: (Color: #0000FF02);
    Anchor: (Width: 700, Height: 760);
    Padding: (Left: 2, Right: 5, Top: 2);
    Group #R0 {
        LayoutMode: Right;
        Background: (Color: #0000FF02);
        Anchor: (Height: 60);
        $C.@TextButton #QuickAccessButtonStatus {
            Background: (Color: #04CC00);
            Anchor: (Width: 200, Height: 55);
            Text: "Quick-Access: Unknown";
        }
        Group #R0Spacer0 {
            LayoutMode: Top;
            Background: (Color: #00000000);
            Anchor: (Width: 60, Height: 120);
        }
        $C.@TextButton #QuickAccessButtonHelp {
            Background: (Color: #04CC00);
            Anchor: (Width: 120, Height: 55);
            Text: "Help";
        }
        Group #R0Spacer1 {
            LayoutMode: Top;
            Background: (Color: #00000000);
            Anchor: (Width: 60, Height: 120);
        }
        $C.@TextButton #QuickAccessButtonSettings {
            Background: (Color: #04CC00);
            Anchor: (Width: 120, Height: 55);
            Text: "Settings";
        }
    }

    Group #RadialContainer {
        Background: (Color: #0000FF02);
        Anchor: (Width: 700, Height: 700);
        LayoutMode: Top;

        Group #HighlightDefault {
            Anchor: (Width: 700, Height: 700);
            Background: (PatchStyle(TexturePath: "../Radials/Images/Eight/QuickAccessRadialMenuDrawing_Eight_Default.png"));
            Visible: false;
        }
        Group #Highlight0 {
            Anchor: (Width: 700, Height: 700);
            Background: (PatchStyle(TexturePath: "../Radials/Images/Eight/QuickAccessRadialMenuDrawing_Eight_0.png"));
            Visible: false;
        }
        Group #Highlight1 {
            Anchor: (Width: 700, Height: 700);
            Background: (PatchStyle(TexturePath: "../Radials/Images/Eight/QuickAccessRadialMenuDrawing_Eight_1.png"));
            Visible: false;
        }
        Group #Highlight2 {
            Anchor: (Width: 700, Height: 700);
            Background: (PatchStyle(TexturePath: "../Radials/Images/Eight/QuickAccessRadialMenuDrawing_Eight_2.png"));
            Visible: false;
        }
        Group #Highlight3 {
            Anchor: (Width: 700, Height: 700);
            Background: (PatchStyle(TexturePath: "../Radials/Images/Eight/QuickAccessRadialMenuDrawing_Eight_3.png"));
            Visible: false;
        }
        Group #Highlight4 {
            Anchor: (Width: 700, Height: 700);
            Background: (PatchStyle(TexturePath: "../Radials/Images/Eight/QuickAccessRadialMenuDrawing_Eight_4.png"));
            Visible: false;
        }
        Group #Highlight5 {
            Anchor: (Width: 700, Height: 700);
            Background: (PatchStyle(TexturePath: "../Radials/Images/Eight/QuickAccessRadialMenuDrawing_Eight_5.png"));
            Visible: false;
        }
        Group #Highlight6 {
            Anchor: (Width: 700, Height: 700);
            Background: (PatchStyle(TexturePath: "../Radials/Images/Eight/QuickAccessRadialMenuDrawing_Eight_6.png"));
            Visible: false;
        }
        Group #Highlight7 {
            Anchor: (Width: 700, Height: 700);
            Background: (PatchStyle(TexturePath: "../Radials/Images/Eight/QuickAccessRadialMenuDrawing_Eight_7.png"));
            Visible: false;
        }
        Group #HighlightEquipped {
            Anchor: (Width: 700, Height: 700);
            Background: (PatchStyle(TexturePath: "../Radials/Images/Eight/QuickAccessRadialMenuDrawing_Eight_Equipped.png"));
            Visible: false;
        }

        Button #QuickAccessButton0 {
            Anchor: (Width: 175, Height: 175, Left: 175, Top: -675);
            TooltipText: "BTN 0";
            Disabled: true;
            Background: (Color: #FF000000);
            LayoutMode: MiddleCenter;

            ItemPreviewComponent #QuickAccessButton0Img {
                Anchor: (Width: 175, Height: 175);
                Visible: true;
                HitTestVisible: false;
                TextTooltipShowDelay: 1.0;
                ItemScale: 0.9;
            }
        }
