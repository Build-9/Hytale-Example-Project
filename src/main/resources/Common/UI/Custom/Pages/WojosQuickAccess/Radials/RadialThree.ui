$C = "../../../Common.ui";

Group {
    LayoutMode: Top;
    Anchor: (Width: 700, Height: 760);
    Padding: (Left: 2, Right: 5, Top: 2);
    Background: (Color: #0000FF02);
    Group #R0 {
        LayoutMode: Right;
        Background: (Color: #0000FF02);
        Anchor: (Height: 60);
        $C.@TextButton #QuickAccessButtonStatus {
            Background: (Color: #04CC00);
            Anchor: (Width: 200, Height: 55);
            Text: "Quick-Access: Unknown";
        }
        Group #R0Spacer0 {
            LayoutMode: Top;
            Background: (Color: #00000000);
            Anchor: (Width: 60, Height: 120);
        }
        $C.@TextButton #QuickAccessButtonHelp {
            Background: (Color: #04CC00);
            Anchor: (Width: 120, Height: 55);
            Text: "Help";
        }
        Group #R0Spacer1 {
            LayoutMode: Top;
            Background: (Color: #00000000);
            Anchor: (Width: 60, Height: 120);
        }
        $C.@TextButton #QuickAccessButtonSettings {
            Background: (Color: #04CC00);
            Anchor: (Width: 120, Height: 55);
            Text: "Settings";
        }
    }
                         
    Group #RadialContainer {
        Background: (Color: #0000FF02);
        Anchor: (Width: 700, Height: 700);
        LayoutMode: Top;

        Group #HighlightDefault {
            Anchor: (Width: 700, Height: 700);
            Background: (PatchStyle(TexturePath: "../Radials/Images/Three/QuickAccessRadialMenuDrawing_Three_Default.png"));
            Visible: false;
        }
        Group #HighlightEquipped {
            Anchor: (Width: 700, Height: 700);
            Background: (PatchStyle(TexturePath: "../Radials/Images/Three/QuickAccessRadialMenuDrawing_Three_Equipped.png"));
            Visible: false;
        }
        Group #Highlight0 {
            Anchor: (Width: 700, Height: 700);
            Background: (PatchStyle(TexturePath: "../Radials/Images/Three/QuickAccessRadialMenuDrawing_Three_0.png"));
            Visible: false;
        }
        Group #Highlight1 {
            Anchor: (Width: 700, Height: 700);
            Background: (PatchStyle(TexturePath: "../Radials/Images/Three/QuickAccessRadialMenuDrawing_Three_1.png"));
            Visible: false;
        }
        Group #Highlight2 {
            Anchor: (Width: 700, Height: 700);
            Background: (PatchStyle(TexturePath: "../Radials/Images/Three/QuickAccessRadialMenuDrawing_Three_2.png"));
            Visible: false;
        }

        Button #QuickAccessButton0 {
            Anchor: (Width: 350, Height: 400, Left: 0, Top: -700);
            TooltipText: "BTN 0";
            Disabled: true;
            Background: (Color: #FF000000);
            LayoutMode: MiddleCenter;

            ItemPreviewComponent #QuickAccessButton0Img {
                Anchor: (Width: 200, Height: 200);
                Visible: true;
                HitTestVisible: false;
                TextTooltipShowDelay: 1.0;
                ItemScale: 0.9;
            }
        }
        Button #QuickAccessButton1 {
            Anchor: (Width: 350, Height: 400, Top: -400, Left: 350);
            TooltipText: "BTN 1";
            Disabled: true;
            Background: (Color: #0000FF00);
            LayoutMode: MiddleCenter;

            ItemPreviewComponent #QuickAccessButton1Img {
                Anchor: (Width: 200, Height: 200);
                Visible: true;
                HitTestVisible: false;
                TextTooltipShowDelay: 1.0;
                ItemScale: 0.9;
            }
        }

        Button #QuickAccessButtonEquipped {
            Anchor: (Width: 200, Height: 200, Left: 250, Top: -150);
            TooltipText: "Equipped";
            Disabled: true;
            Background: (Color: #00FF0000);
            LayoutMode: MiddleCenter;

            ItemPreviewComponent #QuickAccessButtonEquippedImg {
                Anchor: (Width: 90, Height: 90);
                Visible: true;
                HitTestVisible: false;
                TextTooltipShowDelay: 1.0;
                ItemScale: 0.9;
            }
        }

        Button #QuickAccessButton2 {
            Anchor: (Width: 700, Height: 250, Left: 0, Top: 0);
            TooltipText: "BTN 2";
            Disabled: true;
            Background: (Color: #0000FF00);
            LayoutMode: MiddleCenter;

            ItemPreviewComponent #QuickAccessButton2Img {
                Anchor: (Width: 200, Height: 200);
                Visible: true;
                HitTestVisible: false;
                TextTooltipShowDelay: 1.0;
                ItemScale: 0.9;
            }
        }
    }
}
