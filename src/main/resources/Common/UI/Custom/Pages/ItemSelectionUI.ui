$C = "../Common.ui";
Group {
    LayoutMode: CenterMiddle;
    Background: #2a2a2a;
    Anchor: (Width: 800, Height: 500);

    $C.@TextButton #Item1Button {
        Anchor: (Width: 150, Height: 150);
        Text: "Item 1";
    }
    Group {
        Anchor: (Width: 100, Height: 100);
    }
    $C.@TextButton #Item2Button {
            Anchor: (Width: 150, Height: 150);
            Text: "Item 2";
    }
}
